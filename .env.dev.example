# Configuración del proyecto de Firebase de DESARROLLO.
#
# Copia este fichero a `.env.dev` y rellénalo con los datos de la app web
# del proyecto dev (consola de Firebase > Configuración del proyecto > Tus
# apps > Configuración del SDK). `.env.dev` está ignorado por git.
#
# Se carga ENCIMA de .env, solo con `vite build --mode dev` (npm run
# build:dev). Basta con redefinir lo que cambia entre proyectos: lo que no
# pongas aquí se hereda de .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rincon-de-lectura-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rincon-de-lectura-dev
VITE_FIREBASE_STORAGE_BUCKET=rincon-de-lectura-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
